{
  "manifest_version": 3,
  "name": "Alias Maker",
  "version": "2.0.0",
  "description": "Make tag.random@yourdomain email aliases, fill them into signup forms and keep a registry.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "clipboardWrite"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "New alias"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Open Alias Maker"
    }
  }
}
