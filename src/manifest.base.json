{
  "manifest_version": 3,
  "name": "Alias Maker",
  "version": "2.1.0",
  "description": "Make tag.random@yourdomain email aliases, fill them into signup forms and keep a registry.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.cloudflare.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "New alias",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open Alias Maker"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
